{
  "format": "s3d.dvs.visualization-preset",
  "version": "1.0",
  "id": "lmts.benchmark.landscape.v1",
  "source_format": "lmts.report/1.1",
  "input_template_ref": "lmts.report.v1.1",
  "generations": [
    {
      "id": "benchmark-results",
      "primitive": "box",
      "group_by": ["target", "test"],
      "parameters": {
        "score_scale": "scale.score_percent"
      },
      "bindings": {
        "position.x": {
          "column": "target",
          "interpretation": "categorical-index",
          "transform": {
            "spacing": 2.0
          }
        },
        "position.y": {
          "column": "score_percent",
          "interpretation": "number-or-null",
          "transform": {
            "domain": [0.0, 1.0],
            "range": [0.1, 3.0],
            "null": "not-rendered"
          }
        },
        "position.z": {
          "column": "test",
          "interpretation": "categorical-index",
          "transform": {
            "spacing": 2.0
          }
        },
        "scale.y": {
          "column": "score_percent",
          "interpretation": "number-or-null",
          "transform": {
            "domain": [0.0, 1.0],
            "range": [0.1, 3.0],
            "null": "not-rendered"
          }
        },
        "color.r": {
          "column": "result",
          "interpretation": "category-channel",
          "transform": {
            "map": {
              "pass": 0.15,
              "fail": 0.95,
              "error": 1.0,
              "cancelled": 0.55,
              "unknown": 0.45
            }
          }
        },
        "color.g": {
          "column": "result",
          "interpretation": "category-channel",
          "transform": {
            "map": {
              "pass": 0.85,
              "fail": 0.45,
              "error": 0.15,
              "cancelled": 0.35,
              "unknown": 0.45
            }
          }
        },
        "color.b": {
          "column": "result",
          "interpretation": "category-channel",
          "transform": {
            "map": {
              "pass": 0.30,
              "fail": 0.10,
              "error": 0.15,
              "cancelled": 0.90,
              "unknown": 0.45
            }
          }
        }
      }
    }
  ]
}
