{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:lmts:report:1.0",
  "title": "LMTS Report Format",
  "description": "Generic presentation/report projection for LMTS test results. The report is not canonical evidence; source LMTS result records remain the source of truth.",
  "type": "object",
  "required": ["format", "version", "report", "source", "dimensions", "entities", "records", "summary", "views", "extensions"],
  "additionalProperties": false,
  "properties": {
    "format": {"const": "lmts.report"},
    "version": {"const": "1.0"},
    "report": {
      "type": "object",
      "required": ["id", "type", "title", "created_at"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "type": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "created_at": {"type": "string", "format": "date-time"},
        "description": {"type": "string"},
        "tags": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
      }
    },
    "source": {
      "type": "object",
      "required": ["type", "id"],
      "additionalProperties": false,
      "properties": {
        "type": {"type": "string", "minLength": 1},
        "id": {"type": "string", "minLength": 1},
        "schema_version": {"anyOf": [{"type": "integer", "minimum": 1}, {"type": "string", "minLength": 1}]},
        "exported_at": {"type": "string", "format": "date-time"}
      }
    },
    "dimensions": {"type": "object", "minProperties": 1, "additionalProperties": {"$ref": "#/$defs/dimension"}},
    "entities": {"type": "object", "additionalProperties": {"type": "object", "additionalProperties": {"$ref": "#/$defs/entity"}}},
    "records": {"type": "array", "items": {"$ref": "#/$defs/record"}},
    "summary": {
      "type": "object",
      "required": ["records", "outcomes"],
      "additionalProperties": false,
      "properties": {
        "records": {"type": "integer", "minimum": 0},
        "outcomes": {
          "type": "object",
          "required": ["pass", "fail", "error", "cancelled", "unknown"],
          "additionalProperties": false,
          "properties": {
            "pass": {"type": "integer", "minimum": 0},
            "fail": {"type": "integer", "minimum": 0},
            "error": {"type": "integer", "minimum": 0},
            "cancelled": {"type": "integer", "minimum": 0},
            "unknown": {"type": "integer", "minimum": 0}
          }
        }
      }
    },
    "views": {"type": "array", "items": {"$ref": "#/$defs/view"}},
    "extensions": {"type": "object", "additionalProperties": true}
  },
  "$defs": {
    "json_value": {
      "anyOf": [
        {"type": "string"}, {"type": "number"}, {"type": "integer"}, {"type": "boolean"}, {"type": "null"},
        {"type": "array", "items": {"$ref": "#/$defs/json_value"}},
        {"type": "object", "additionalProperties": {"$ref": "#/$defs/json_value"}}
      ]
    },
    "dimension": {
      "type": "object",
      "required": ["label", "entity_type"],
      "additionalProperties": false,
      "properties": {
        "label": {"type": "string", "minLength": 1},
        "entity_type": {"type": "string", "minLength": 1},
        "description": {"type": "string"}
      }
    },
    "entity": {
      "type": "object",
      "required": ["label", "properties"],
      "additionalProperties": false,
      "properties": {
        "label": {"type": "string", "minLength": 1},
        "properties": {"type": "object", "additionalProperties": {"$ref": "#/$defs/json_value"}}
      }
    },
    "metric": {
      "type": "object",
      "required": ["value"],
      "additionalProperties": false,
      "properties": {
        "value": {"$ref": "#/$defs/json_value"},
        "unit": {"type": "string", "minLength": 1}
      }
    },
    "error": {
      "type": "object",
      "required": ["type", "message"],
      "additionalProperties": false,
      "properties": {
        "type": {"type": "string", "minLength": 1},
        "message": {"type": "string"}
      }
    },
    "record": {
      "type": "object",
      "required": ["id", "coordinates", "outcome", "metrics"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "coordinates": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string", "minLength": 1}},
        "outcome": {
          "type": "object",
          "required": ["status", "result"],
          "additionalProperties": false,
          "properties": {
            "status": {"type": "string", "minLength": 1},
            "result": {"enum": ["pass", "fail", "error", "cancelled", "unknown"]}
          }
        },
        "metrics": {"type": "object", "additionalProperties": {"$ref": "#/$defs/metric"}},
        "error": {"$ref": "#/$defs/error"}
      }
    },
    "view": {
      "type": "object",
      "required": ["id", "type"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "type": {"type": "string", "minLength": 1},
        "title": {"type": "string"},
        "row_dimension": {"type": "string", "minLength": 1},
        "column_dimension": {"type": "string", "minLength": 1},
        "value": {"type": "string", "minLength": 1}
      },
      "allOf": [{"if": {"properties": {"type": {"const": "matrix"}}, "required": ["type"]}, "then": {"required": ["row_dimension", "column_dimension", "value"]}}],
      "additionalProperties": false
    }
  }
}
