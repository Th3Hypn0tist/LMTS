{
  "format": "s3d.dvs.visualization-preset",
  "version": "1.0",
  "id": "lmts.report-telemetry-percent.landscape.v1",
  "source_format": "lmts.dvs.report-telemetry-percent/1.0",
  "input_template_ref": "lmts.report-telemetry-percent.v1.0",
  "generations": [
    {
      "id": "percent-telemetry",
      "primitive": "box",
      "group_by": ["run_key", "metric_key"],
      "bindings": {
        "position.x": {
          "column": "run_key",
          "interpretation": "categorical-index",
          "transform": {"spacing": 1.2}
        },
        "position.y": {
          "column": "value",
          "interpretation": "number",
          "transform": {"domain": [0.0, 100.0], "range": [0.1, 3.0], "clamp": true}
        },
        "position.z": {
          "column": "metric_key",
          "interpretation": "categorical-index",
          "transform": {"spacing": 1.2}
        },
        "scale.y": {
          "column": "value",
          "interpretation": "number",
          "transform": {"domain": [0.0, 100.0], "range": [0.1, 3.0], "clamp": true}
        },
        "color.r": {
          "column": "result",
          "interpretation": "category-channel",
          "transform": {"map": {"pass": 0.15, "fail": 0.95, "error": 1.0, "cancelled": 0.55, "unknown": 0.45}}
        },
        "color.g": {
          "column": "result",
          "interpretation": "category-channel",
          "transform": {"map": {"pass": 0.85, "fail": 0.45, "error": 0.15, "cancelled": 0.35, "unknown": 0.45}}
        },
        "color.b": {
          "column": "result",
          "interpretation": "category-channel",
          "transform": {"map": {"pass": 0.30, "fail": 0.10, "error": 0.15, "cancelled": 0.90, "unknown": 0.45}}
        }
      }
    }
  ]
}
