{
  "format": "s3d.dvs.input-template",
  "version": "1.0",
  "id": "lmts.report.v1.1",
  "source_format": "lmts.report/1.1",
  "reader": "json",
  "rows": "records[*]",
  "columns": [
    {"name": "run_id", "selector": "id", "type": "string"},
    {"name": "target", "selector": "coordinates.target", "type": "string"},
    {"name": "test", "selector": "coordinates.test", "type": "string"},
    {"name": "started_at", "selector": "timing.started_at", "type": "string"},
    {"name": "completed_at", "selector": "timing.completed_at", "type": "string"},
    {"name": "status", "selector": "outcome.status", "type": "string"},
    {"name": "result", "selector": "outcome.result", "type": "string"},
    {"name": "passed", "selector": "outcome.passed", "type": "boolean", "nullable": true},
    {"name": "input_tokens", "selector": "metrics.input_tokens.value", "type": "number", "nullable": true},
    {"name": "output_tokens", "selector": "metrics.output_tokens.value", "type": "number", "nullable": true},
    {"name": "ttft_ms", "selector": "metrics.ttft.value", "type": "number", "nullable": true},
    {"name": "total_ms", "selector": "metrics.total_time.value", "type": "number", "nullable": true},
    {
      "name": "score_percent",
      "selector": "metrics.score_percent.value",
      "type": "number",
      "nullable": true,
      "scale": {"low": 0.0, "high": 100.0, "power": 1.0}
    },
    {"name": "workspace_protocol_steps", "selector": "metrics.workspace_protocol_steps.value", "type": "number", "nullable": true},
    {"name": "output_file_count", "selector": "metrics.output_file_count.value", "type": "number", "nullable": true},
    {"name": "exact_output_match", "selector": "metrics.exact_output_match.value", "type": "boolean", "nullable": true}
  ]
}
